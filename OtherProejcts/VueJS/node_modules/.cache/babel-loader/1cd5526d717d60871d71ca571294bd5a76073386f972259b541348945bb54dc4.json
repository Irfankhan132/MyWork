{"ast":null,"code":"// 1. Make CHild Component.\n// 2. Import and use CHild Component\n// 3. Pass Static Data\n// 4. Pass Property, object, and function to child Component\nimport Child from './ParentChildComponent.vue';\nexport default {\n  name: \"Home\",\n  components: {\n    Child\n  }\n};","map":{"version":3,"names":["Child","name","components"],"sources":["D:\\VueJS\\src\\components\\ParentChildComponent.vue"],"sourcesContent":["<template>\r\n    <h2>How to pass value in child component from parent component</h2>\r\n    <Child />\r\n</template>\r\n\r\n<script>\r\n\r\n// 1. Make CHild Component.\r\n// 2. Import and use CHild Component\r\n// 3. Pass Static Data\r\n// 4. Pass Property, object, and function to child Component\r\nimport Child from './ParentChildComponent.vue'\r\nexport default{\r\n\r\n    name: \"Home\",\r\n    components:{\r\n        Child\r\n    } \r\n\r\n}\r\n\r\n\r\n</script>\r\n\r\n<style>\r\nh1{\r\n\r\n    color: brown;\r\n}\r\n\r\n\r\n</style>"],"mappings":"AAOA;AACA;AACA;AACA;AACA,OAAOA,KAAI,MAAO,4BAA2B;AAC7C,eAAc;EAEVC,IAAI,EAAE,MAAM;EACZC,UAAU,EAAC;IACPF;EACJ;AAEJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}