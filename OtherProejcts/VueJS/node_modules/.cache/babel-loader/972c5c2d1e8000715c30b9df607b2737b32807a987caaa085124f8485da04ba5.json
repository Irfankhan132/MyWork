{"ast":null,"code":"// 1. Make CHild Component.\n// 2. Import and use CHild Component\n// 3. Pass Static Data\n// 4. Pass Property, object, and function to child Component\n\nexport default {\n  name: \"ParentChildComponent\",\n  props: {\n    name2: String,\n    user: Object\n  }\n};","map":{"version":3,"names":["name","props","name2","String","user","Object"],"sources":["D:\\VueJS\\src\\components\\ParentChildComponent.vue"],"sourcesContent":["<template>\r\n    <h2>How to pass value in child component from parent component</h2>\r\n    <h2>{{ name2 }}</h2>\r\n    <h2>{{ user.name }}</h2>\r\n</template>\r\n\r\n<script>\r\n\r\n// 1. Make CHild Component.\r\n// 2. Import and use CHild Component\r\n// 3. Pass Static Data\r\n// 4. Pass Property, object, and function to child Component\r\n\r\nexport default{\r\n\r\n    name: \"ParentChildComponent\",\r\n    props:{\r\n        name2:String,\r\n        user:Object\r\n    }\r\n\r\n}\r\n\r\n\r\n</script>\r\n\r\n<style>\r\nh1{\r\n\r\n    color: brown;\r\n}\r\n\r\n\r\n</style>"],"mappings":"AAQA;AACA;AACA;AACA;;AAEA,eAAc;EAEVA,IAAI,EAAE,sBAAsB;EAC5BC,KAAK,EAAC;IACFC,KAAK,EAACC,MAAM;IACZC,IAAI,EAACC;EACT;AAEJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}